+#[test]
+fn a_block_another_author_added_an_attribute_to_stays_whole() {
+    let after = revert_creator_of_block(|doc, block| {
+        doc.put(block, "align", "center").unwrap();
+    });
+
+    assert_eq!(
+        after,
+        serde_json::json!({"blocks": [{"type": "paragraph", "text": "Figure 1", "align": "center"}]})
+    );
+}
