+#[test]
+fn gate_counter() {
+    let counts = count_counter(0..GATE_SEEDS);
+
+    assert!(counts.independent > 0, "no histories were generated");
+    assert_eq!(
+        counts.hook_violations, 0,
+        "first counterexample: {:?}",
+        counts.hook_example
+    );
+}
