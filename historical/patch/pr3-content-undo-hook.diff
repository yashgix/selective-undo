+//! Tilo's selective revert as the resource store's content undo. It lives here, where both are
+//! linked: collaboration stays free of the store.
+
+use automerge::{AutoCommit, ChangeHash};
+use tilo_resource_store::ContentUndo;
+
+use collaboration::history_source::authors::{HistoryAuthor, ResolveAuthor};
+use collaboration::history_source::revert::revert_changes;
+
+/// Names every actor by its hex: the outcome's text is not used here.
+pub struct ActorNamed;
+
+impl ResolveAuthor for ActorNamed {
+    fn resolve(&self, actor: &str) -> HistoryAuthor {
+        HistoryAuthor::new(actor, 0.0, actor)
+    }
+}
+
+/// Undoes an invocation's changes with [`revert_changes`], keeping later independent edits.
+pub struct RevertContentUndo;
+
+impl ContentUndo for RevertContentUndo {
+    fn undo(&self, doc: &mut AutoCommit, changes: &[(ChangeHash, String)]) -> Result<(), String> {
+        revert_changes(doc, changes, &ActorNamed)
+            .map(|_| ())
+            .map_err(|error| format!("{error:?}"))
+    }
+}
