+#[test]
+fn a_moved_target_word_is_order_only_and_other_differences_are_violated() {
+    let reorder = classify(Some("b1 b0 "), "b0 b1 ", "b1");
+    let other_word = classify(Some("b0 b1 x9 "), "b0 b1 n1 ", "b1");
+    let missing_word = classify(Some("b0 b1 "), "b0 b1 n1 ", "b1");
+    let failed = classify(None, "b0 b1 ", "b1");
+
+    assert!(matches!(reorder, Outcome::OrderOnly));
+    assert!(matches!(other_word, Outcome::Violated));
+    assert!(matches!(missing_word, Outcome::Violated));
+    assert!(matches!(failed, Outcome::Violated));
+}
