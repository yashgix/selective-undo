+#[test]
+fn a_later_word_moved_past_an_unrelated_word_is_violated() {
+    // The target restored b1. n1 is a later author's word and b2 is unrelated to the target.
+    let moved = classify(Some("b0 b1 b2 n1 "), "b0 b1 n1 b2 ", "b1");
+
+    assert!(matches!(moved, Outcome::Violated));
+}
