+/// What a run of counter histories found, with and without the hook.
+struct CounterCounts {
+    independent: u64,
+    today_violations: u64,
+    hook_violations: u64,
+    today_example: Option<JsonValue>,
+    hook_example: Option<JsonValue>,
+}
+
+fn count_counter(seeds: Range<u64>) -> CounterCounts {
+    let mut independent = 0_u64;
+    let mut today_violations = 0_u64;
+    let mut hook_violations = 0_u64;
+    let mut today_example = None;
+    let mut hook_example = None;
+
+    for seed in seeds {
+        independent += 1;
+        let case = counter_case(seed);
+        let expected = case.expected();
+        let today = undone_count(&case, false);
+        let hooked = undone_count(&case, true);
+        if today != Some(expected) {
+            today_violations += 1;
+            today_example.get_or_insert_with(|| counter_example(&case, expected, today));
+        }
+        if hooked != Some(expected) {
+            hook_violations += 1;
+            hook_example.get_or_insert_with(|| counter_example(&case, expected, hooked));
+        }
+    }
+
+    CounterCounts {
+        independent,
+        today_violations,
+        hook_violations,
+        today_example,
+        hook_example,
+    }
+}
