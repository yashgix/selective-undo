@@ -0,0 +1,259 @@
+#![cfg(feature = "apps")]
+#![allow(clippy::unwrap_used, reason = "test assertions")]
+
+//! One person's reaction undone on two devices that sync, with the commands a Chat reaction sends:
+//! the workspace service's content undo keeps the other person's reaction, and takes back the
+//! undone one even when that reaction made the map the other one was written into.
+
+use serde_json::{Value, json};
+use tilo_resource_store::wire::{self, Command, Edit};
+use tilo_resource_store::{Proposal, Received, Resource, Stamp, Store, Written};
+use tilo_workspace_service::workspaces::content_undo::RevertContentUndo;
+
+fn stamp(invocation: &str, who: &str) -> Stamp {
+    Stamp {
+        invocation: invocation.to_owned(),
+        invoker: who.to_owned(),
+        ..Stamp::default()
+    }
+}
+
+fn device(hook: bool) -> Store {
+    let mut store = Store::new();
+    if hook {
+        store.set_content_undo(Box::new(RevertContentUndo));
+    }
+    store
+}
+
+fn message_made(store: &mut Store) -> Vec<Written> {
+    let resource = Resource {
+        readers: "*".to_owned(),
+        ..Resource::default()
+    };
+    store
+        .put("message", "m1", resource, &stamp("made", "ada"))
+        .unwrap()
+}
+
+fn react(store: &mut Store, invocation: &str, who: &str) -> Vec<Written> {
+    let edit = Edit::MapPut {
+        field: "reactions".to_owned(),
+        key: format!("thumbs\u{1f}{who}"),
+        value: json!(true),
+    };
+    let command = Command::Edit {
+        kind: "message".to_owned(),
+        id: "m1".to_owned(),
+        edits: vec![edit],
+        stamp: stamp(invocation, who),
+    };
+    wire::write(store, command).unwrap()
+}
+
+fn undo(store: &mut Store, invocation: &str, who: &str) -> Vec<Written> {
+    let undo = Stamp {
+        verb: "undo".to_owned(),
+        undoes: Some(invocation.to_owned()),
+        ..stamp(&format!("undo-{invocation}"), who)
+    };
+    let command = Command::Undo {
+        invocation: invocation.to_owned(),
+        stamp: undo,
+    };
+    wire::write(store, command).unwrap()
+}
+
+fn deliver(store: &mut Store, writes: &[Written]) {
+    for written in writes {
+        let received = Received {
+            change: written.change.clone(),
+            author: [0; 32],
+        };
+        store
+            .receive(
+                &written.doc,
+                &written.readers,
+                vec![received],
+                &|_: &Proposal<'_>| true,
+            )
+            .unwrap();
+    }
+}
+
+fn people(store: &Store) -> Vec<String> {
+    let content = store.content_json("message", "m1").unwrap_or(Value::Null);
+    let mut names: Vec<String> = content
+        .get("reactions")
+        .and_then(Value::as_object)
+        .map(|map| {
+            map.keys()
+                .filter_map(|key| key.split('\u{1f}').nth(1).map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default();
+    names.sort();
+    names
+}
+
+/// Ada reacts (after Cy, when `earlier`), Ben reacts, Ada undoes; the reactions each device sees.
+fn ada_undoes(hook: bool, earlier: bool) -> (Vec<String>, Vec<String>) {
+    let (mut ada, mut ben) = (device(hook), device(hook));
+    let base = message_made(&mut ada);
+    deliver(&mut ben, &base);
+    if earlier {
+        let cy = react(&mut ada, "cy-reacts", "cy");
+        deliver(&mut ben, &cy);
+    }
+    let reaction = react(&mut ada, "ada-reacts", "ada");
+    deliver(&mut ben, &reaction);
+    let reaction = react(&mut ben, "ben-reacts", "ben");
+    deliver(&mut ada, &reaction);
+    let undone = undo(&mut ada, "ada-reacts", "ada");
+    deliver(&mut ben, &undone);
+    (people(&ada), people(&ben))
+}
+
+fn both(names: &[&str]) -> (Vec<String>, Vec<String>) {
+    let names: Vec<String> = names.iter().map(|name| (*name).to_owned()).collect();
+    (names.clone(), names)
+}
+
+#[test]
+fn todays_undo_takes_back_the_other_persons_reaction_too() {
+    assert_eq!(ada_undoes(false, false), both(&[]));
+    assert_eq!(ada_undoes(false, true), both(&["cy"]));
+}
+
+#[test]
+fn the_content_undo_takes_back_only_the_undone_reaction_when_it_made_the_map() {
+    assert_eq!(ada_undoes(true, false), both(&["ben"]));
+}
+
+#[test]
+fn the_content_undo_takes_back_only_the_undone_reaction_when_the_map_was_there() {
+    assert_eq!(ada_undoes(true, true), both(&["ben", "cy"]));
+}
+
+/// Ada's invocation makes a `box` map of a plain value and an object; Ben writes a plain value beside them; Ada undoes.
+fn a_map_with_an_object_in_it_survives_the_undo() -> serde_json::Value {
+    let (mut ada, mut ben) = (device(true), device(true));
+    let base = message_made(&mut ada);
+    deliver(&mut ben, &base);
+    let put = |field: &str, key: &str, value: Value| Edit::MapPut {
+        field: field.to_owned(),
+        key: key.to_owned(),
+        value,
+    };
+    let command = Command::Edit {
+        kind: "message".to_owned(),
+        id: "m1".to_owned(),
+        edits: vec![
+            put("box", "type", json!("paragraph")),
+            put("box", "text", json!({"words": "Figure 1"})),
+        ],
+        stamp: stamp("ada-box", "ada"),
+    };
+    let written = wire::write(&mut ada, command).unwrap();
+    deliver(&mut ben, &written);
+    let command = Command::Edit {
+        kind: "message".to_owned(),
+        id: "m1".to_owned(),
+        edits: vec![put("box", "align", json!("center"))],
+        stamp: stamp("ben-box", "ben"),
+    };
+    let written = wire::write(&mut ben, command).unwrap();
+    deliver(&mut ada, &written);
+    undo(&mut ada, "ada-box", "ada");
+    ada.content_json("message", "m1").unwrap_or(Value::Null)
+}
+
+#[test]
+fn a_map_holding_an_object_stays_whole_when_the_other_author_wrote_beside_it() {
+    let content = a_map_with_an_object_in_it_survives_the_undo();
+
+    assert_eq!(
+        content.get("box"),
+        Some(&json!({"type": "paragraph", "text": {"words": "Figure 1"}, "align": "center"}))
+    );
+}
+
+/// Writes `value` at the entry `key` of the map field `box` of the message, as `who`.
+fn put_entry(
+    store: &mut Store,
+    invocation: &str,
+    who: &str,
+    key: &str,
+    value: Value,
+) -> Vec<Written> {
+    let edit = Edit::MapPut {
+        field: "box".to_owned(),
+        key: key.to_owned(),
+        value,
+    };
+    let command = Command::Edit {
+        kind: "message".to_owned(),
+        id: "m1".to_owned(),
+        edits: vec![edit],
+        stamp: stamp(invocation, who),
+    };
+    wire::write(store, command).unwrap()
+}
+
+fn box_of(store: &Store) -> Value {
+    let content = store.content_json("message", "m1").unwrap_or(Value::Null);
+    content.get("box").cloned().unwrap_or(Value::Null)
+}
+
+#[test]
+fn an_entry_the_other_author_wrote_again_after_the_undone_invocation_survives_its_undo() {
+    let (mut ada, mut ben) = (device(true), device(true));
+    let base = message_made(&mut ada);
+    deliver(&mut ben, &base);
+    let first = put_entry(&mut ada, "ada-writes", "ada", "k", json!("one"));
+    deliver(&mut ben, &first);
+    let later = put_entry(&mut ben, "ben-writes", "ben", "k", json!("two"));
+    deliver(&mut ada, &later);
+    let undone = undo(&mut ada, "ada-writes", "ada");
+    deliver(&mut ben, &undone);
+
+    assert_eq!(box_of(&ada), json!({"k": "two"}));
+    assert_eq!(box_of(&ben), json!({"k": "two"}));
+}
+
+#[test]
+fn an_entry_the_other_author_wrote_at_the_same_time_with_the_same_value_survives_the_undo() {
+    let (mut ada, mut ben) = (device(true), device(true));
+    let base = message_made(&mut ada);
+    deliver(&mut ben, &base);
+    // One invocation of two changes: the first makes the map, the second writes the entry.
+    let made = put_entry(&mut ada, "ada-writes", "ada", "seed", json!(1));
+    deliver(&mut ben, &made);
+    let entry = put_entry(&mut ada, "ada-writes", "ada", "k", json!("same"));
+    let concurrent = put_entry(&mut ben, "ben-writes", "ben", "k", json!("same"));
+    deliver(&mut ada, &concurrent);
+    deliver(&mut ben, &entry);
+    let undone = undo(&mut ada, "ada-writes", "ada");
+    deliver(&mut ben, &undone);
+
+    assert_eq!(box_of(&ada), json!({"k": "same"}));
+    assert_eq!(box_of(&ben), json!({"k": "same"}));
+}
+
+#[test]
+fn an_entry_written_again_with_the_same_value_is_no_write_so_the_whole_map_goes() {
+    let (mut ada, mut ben) = (device(true), device(true));
+    let base = message_made(&mut ada);
+    deliver(&mut ben, &base);
+    let first = put_entry(&mut ada, "ada-writes", "ada", "k", json!("one"));
+    deliver(&mut ben, &first);
+    let again = put_entry(&mut ben, "ben-writes", "ben", "k", json!("one"));
+    deliver(&mut ada, &again);
+    let undone = undo(&mut ada, "ada-writes", "ada");
+    deliver(&mut ben, &undone);
+
+    // Automerge keeps no operation for a put of the value already there, so there is no write by
+    // Ben for the undo to protect. Nobody wrote into the map, so it goes whole.
+    assert_eq!(box_of(&ada), Value::Null);
+    assert_eq!(box_of(&ben), Value::Null);
+}
diff --git a/crates/server/tilo-workspace-service/tests/selective_undo_store.rs b/crates/server/tilo-workspace-service/tests/selective_undo_store.rs
