+/// What a run of text histories found, with and without the hook. The pairs hold the
+/// violations and the order-only differences.
+struct TextCounts {
+    independent: u64,
+    today: [u64; 2],
+    hook: [u64; 2],
+    today_example: Option<JsonValue>,
+    hook_example: Option<JsonValue>,
+}
+
+fn count_text(seeds: Range<u64>) -> TextCounts {
+    let mut independent_count = 0_u64;
+    let mut today = [0_u64; 2];
+    let mut hook = [0_u64; 2];
+    let mut today_example = None;
+    let mut hook_example = None;
+
+    for seed in seeds {
+        let case = text_case(seed);
+        if !independent(&case) {
+            continue;
+        }
+        independent_count += 1;
+        let expected = replay_without_target(&case);
+        let today_got = undone_body(&case, false);
+        let hook_got = undone_body(&case, true);
+        let tallies = [
+            (&mut today, &mut today_example, today_got),
+            (&mut hook, &mut hook_example, hook_got),
+        ];
+        for (tally, example, got) in tallies {
+            match classify(got.as_deref(), &expected, target_word(&case)) {
+                Outcome::Holds => {}
+                Outcome::OrderOnly => tally[1] += 1,
+                Outcome::Violated => {
+                    tally[0] += 1;
+                    example.get_or_insert_with(|| text_example(&case, &expected, got.as_deref()));
+                }
+            }
+        }
+    }
+
+    TextCounts {
+        independent: independent_count,
+        today,
+        hook,
+        today_example,
+        hook_example,
+    }
+}
+
+#[test]
+fn gate_text() {
+    let counts = count_text(0..GATE_SEEDS);
+
+    assert!(
+        counts.independent > 0,
+        "no independent histories were generated"
+    );
+    assert_eq!(
+        counts.hook[0], 0,
+        "first counterexample: {:?}",
+        counts.hook_example
+    );
+}
+
+#[test]
+#[ignore = "a measurement: run it by name"]
+fn measure_text() {
+    let seeds = seeds();
+    let counts = count_text(0..seeds);
+
+    let output = json!({
+        "histories": seeds,
+        "independent": counts.independent,
+        "today_violations": counts.today[0],
+        "hook_violations": counts.hook[0],
+        "today_order_only": counts.today[1],
+        "hook_order_only": counts.hook[1],
+        "today_example": counts.today_example,
+        "hook_example": counts.hook_example,
+    });
+    println!("{output}");
+}
