+/// After the hook has kept a map the invocation made (somebody wrote into it since), takes back
+/// the plain entries the invocation put there and nobody has set again. Only a flat map counts: one
+/// whose entries are all plain values is a keyed collection, so its entries stand alone. A map
+/// holding an object (a block with its text) is a structure others built on, and stays whole.
+pub(crate) fn take_back_entries(
+    span: &Span,
+    became: &Automerge,
+    fork: &mut AutoCommit,
+    keys: &[String],
+) -> Result<(), automerge::AutomergeError> {
+    for key in keys {
+        let Some((Value::Object(ObjType::Map), map)) = became.get(ROOT, key)? else {
+            continue;
+        };
+        let Some((Value::Object(ObjType::Map), now)) = fork.get(ROOT, key)? else {
+            continue;
+        };
+        if now != map || !span.made(&map) || !is_flat(fork, &map) {
+            continue;
+        }
+        let mut own = Vec::new();
+        for item in became.map_range(&map, ..) {
+            // Only the invocation's own write stands at the entry: nobody set it again, and no
+            // concurrent write is held beside it.
+            let alone = fork.get_all(&map, item.key.as_ref())?;
+            let still_theirs = matches!(alone.as_slice(), [(_, id)] if *id == item.id());
+            if still_theirs {
+                own.push(item.key.to_string());
+            }
+        }
+        for name in own {
+            fork.delete(&map, name.as_str())?;
+        }
+    }
+    Ok(())
+}
