+#![cfg(any(feature = "agents", feature = "apps"))]
+#![allow(
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::arithmetic_side_effects,
+    clippy::indexing_slicing,
+    reason = "test assertions and a small generator"
+)]
+
+//! `Store::undo` with Tilo's revert installed, on the histories the selective-undo generator
+//! makes: one invocation is undone and the result is compared with a replay without it.
+
+use std::env;
+use std::ops::Range;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use automerge::transaction::{Transactable as _, Transaction};
+use automerge::{AutoCommit, ChangeHash, ObjId, ObjType, ReadDoc as _, ScalarValue};
+use serde_json::Value as JsonValue;
+use tilo_resource_store::{Admit, ContentUndo, Proposal, Received, Store};
+use tilo_workspace_service::workspaces::content_undo::RevertContentUndo;
+
+#[allow(dead_code, reason = "the generator serves more than one checker")]
+#[path = "../../../collab/resource-store/tests/selective_undo.rs"]
+mod undo_gen;
+
+use undo_gen::{Case, Commits, History, Invocation, Op, P1Outcome};
+
+fn install(store: &mut Store) {
+    store.set_content_undo(Box::new(RevertContentUndo));
+}
+
+fn violates(case: &Case, commits: Commits) -> bool {
+    matches!(
+        undo_gen::p1_outcome_with_commits(case, &install, commits),
+        Ok(P1Outcome::Violated)
+    )
+}
+
+/// A history of the base invocation, the target `i2` and one later invocation `i3`.
+fn case(target_ops: Vec<Op>, later_ops: Vec<Op>) -> Case {
+    let invocation = |id: &str, ops| Invocation {
+        id: id.to_owned(),
+        ops,
+    };
+    Case {
+        history: History {
+            invocations: vec![
+                invocation("i1", Vec::new()),
+                invocation("i2", target_ops),
+                invocation("i3", later_ops),
+            ],
+        },
+        target: "i2".to_owned(),
+    }
+}
+
+/// The content after undoing the target, with the hook installed.
+fn undone(case: &Case) -> JsonValue {
+    assert!(undo_gen::valid_history(&case.history));
+    let mut store = undo_gen::play_history(&case.history, None).unwrap();
+    install(&mut store);
+    store
+        .undo(&case.target, &undo_gen::undo_stamp(&case.target))
+        .unwrap();
+    undo_gen::observe(&store)
+}
+
+#[test]
+fn undoing_a_new_key_keeps_a_later_new_key() {
+    let case = case(
+        vec![Op::CreateMap {
+            parent: "i1:meta".to_owned(),
+            key: "k0".to_owned(),
+            name: "i2:c0".to_owned(),
+        }],
+        vec![Op::CreateMap {
+            parent: "i1:meta".to_owned(),
+            key: "k5".to_owned(),
+            name: "i3:c1".to_owned(),
+        }],
+    );
+
+    let after = undone(&case);
+
+    assert!(after["meta"].get("k5").is_some());
+    assert!(after["meta"].get("k0").is_none());
+    assert_eq!(undo_gen::p1_violation_with(&case, &install), Ok(false));
+}
+
+#[test]
+fn undoing_a_new_list_keeps_a_later_insert_into_items() {
+    let case = case(
+        vec![Op::CreateList {
+            parent: "i1:meta".to_owned(),
+            key: "k0".to_owned(),
+            name: "i2:c0".to_owned(),
+        }],
+        vec![Op::Insert {
+            target: "i1:items".to_owned(),
+            after: None,
+            value: "v1".to_owned(),
+        }],
+    );
+
+    let after = undone(&case);
+
+    assert_eq!(after["meta"]["items"], serde_json::json!(["v1"]));
+    assert!(after["meta"].get("k0").is_none());
+    assert_eq!(undo_gen::p1_violation_with(&case, &install), Ok(false));
+}
+
+/// What a run over a range of seeds found.
+struct Counts {
+    independent: u64,
+    p1_violations: u64,
+    p1_order_choices: u64,
+    replay_errors: u64,
+    first_counterexample: Option<Case>,
+}
+
+fn count_range(seeds: Range<u64>, commits: Commits) -> Counts {
+    let mut independent = 0_u64;
+    let mut p1_violations = 0_u64;
+    let mut p1_order_choices = 0_u64;
+    let mut replay_errors = 0_u64;
+    let mut first = None;
+
+    for seed in seeds {
+        let case = undo_gen::generate_case(seed);
+        if !undo_gen::analyse(&case.history, &case.target).independent {
+            continue;
+        }
+        independent += 1;
+        match undo_gen::p1_outcome_with_commits(&case, &install, commits) {
+            Ok(P1Outcome::Holds) => {}
+            Ok(P1Outcome::RestoredOrderOnly) => p1_order_choices += 1,
+            Ok(P1Outcome::Violated) => {
+                p1_violations += 1;
+                if first.is_none() {
+                    first = Some(undo_gen::shrink_by(case, &|candidate| {
+                        violates(candidate, commits)
+                    }));
+                }
+            }
+            Err(_) => replay_errors += 1,
+        }
+    }
+
+    Counts {
+        independent,
+        p1_violations,
+        p1_order_choices,
+        replay_errors,
+        first_counterexample: first,
+    }
+}
+
+const GATE_SEEDS: u64 = 1000;
+
+fn assert_gate(commits: Commits) {
+    let counts = count_range(0..GATE_SEEDS, commits);
+
+    assert!(
+        counts.independent > 0,
+        "no independent histories were generated"
+    );
+    assert_eq!(counts.replay_errors, 0, "histories failed to replay");
+    assert_eq!(
+        counts.p1_violations,
+        0,
+        "first counterexample: {}",
+        serde_json::json!(
+            counts
+                .first_counterexample
+                .as_ref()
+                .map(undo_gen::counterexample_json)
+        )
+    );
+}
+
+#[test]
+fn gate_selective_undo_store() {
+    assert_gate(Commits::One);
+}
+
+#[test]
+fn gate_selective_undo_store_per_op_commits() {
+    assert_gate(Commits::PerOp);
+}
+
+#[test]
+fn per_op_commits_write_one_change_per_op() {
+    let put = |key: &str| Op::PutKey {
+        target: "i1:props".to_owned(),
+        key: key.to_owned(),
+        value: format!("v-{key}"),
+    };
+    let case = case(vec![put("k0"), put("k1")], Vec::new());
+    let mut store = undo_gen::play_history_with(&case.history, None, Commits::PerOp).unwrap();
+
+    let message = undo_gen::stamped("i2").message();
+    let (doc, _) = store
+        .content(undo_gen::KIND, undo_gen::ID)
+        .unwrap()
+        .unwrap();
+    let changes = doc
+        .get_changes(&[])
+        .iter()
+        .filter(|change| change.message().is_some_and(|held| *held == message))
+        .count();
+    assert_eq!(changes, 2);
+
+    install(&mut store);
+    store
+        .undo(&case.target, &undo_gen::undo_stamp(&case.target))
+        .unwrap();
+    assert_eq!(
+        undo_gen::observe(&store)["meta"]["props"],
+        serde_json::json!({})
+    );
+}
+
+#[test]
+#[ignore = "a measurement: run it by name"]
+fn measure() {
+    let seeds = env::var("TILO_SEEDS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(2000);
+    let counts = count_range(0..seeds, Commits::One);
+
+    assert_eq!(counts.p1_violations, 0);
+
+    let output = serde_json::json!({
+        "histories": seeds,
+        "independent": counts.independent,
+        "p1_violations": counts.p1_violations,
+        "p1_order_choices": counts.p1_order_choices,
+        "replay_errors": counts.replay_errors,
+        "first_counterexample": counts
+            .first_counterexample
+            .as_ref()
+            .map(undo_gen::counterexample_json),
+    });
+
+    println!("{output}");
+}
+
+fn put_key(key: &str) -> Op {
+    Op::PutKey {
+        target: "i1:props".to_owned(),
+        key: key.to_owned(),
+        value: format!("v-{key}"),
+    }
+}
+
+#[test]
+fn per_op_undo_keeps_later_change() {
+    let case = case(vec![put_key("k0"), put_key("k1")], vec![put_key("k2")]);
+    let mut store = undo_gen::play_history_with(&case.history, None, Commits::PerOp).unwrap();
+
+    install(&mut store);
+    store
+        .undo(&case.target, &undo_gen::undo_stamp(&case.target))
+        .unwrap();
+
+    assert_eq!(
+        undo_gen::observe(&store),
+        serde_json::json!({"meta": {"props": {"k2": "v-k2"}, "items": []}})
+    );
+}
+
+/// Whether the target made more than one change, and whether a later invocation wrote. Every
+/// invocation writes the one document, so a later invocation with ops touches the same document.
+fn coverage(case: &Case) -> (bool, bool) {
+    let mut invocations = case
+        .history
+        .invocations
+        .iter()
+        .skip_while(|invocation| invocation.id != case.target);
+    let target = invocations.next().expect("the target exists");
+    let later = invocations.any(|invocation| !invocation.ops.is_empty());
+    (target.ops.len() > 1, later)
+}
+
+/// The op kinds the generator produces, in the order `kind_of` numbers them.
+const OP_KINDS: [&str; 6] = [
+    "PutKey",
+    "DeleteKey",
+    "Insert",
+    "Delete",
+    "CreateMap",
+    "CreateList",
+];
+
+fn kind_of(op: &Op) -> usize {
+    match op {
+        Op::PutKey { .. } => 0,
+        Op::DeleteKey { .. } => 1,
+        Op::Insert { .. } => 2,
+        Op::Delete { .. } => 3,
+        Op::CreateMap { .. } => 4,
+        Op::CreateList { .. } => 5,
+    }
+}
+
+/// Which op kinds the target invocation has.
+fn target_op_kinds(case: &Case) -> [bool; OP_KINDS.len()] {
+    let target = case
+        .history
+        .invocations
+        .iter()
+        .find(|invocation| invocation.id == case.target)
+        .expect("the target exists");
+    let mut seen = [false; OP_KINDS.len()];
+    for op in &target.ops {
+        seen[kind_of(op)] = true;
+    }
+    seen
+}
+
+#[test]
+fn gate_coverage_reaches_required_categories() {
+    let mut multi_change_targets = 0_u64;
+    let mut later_writers = 0_u64;
+    let mut kind_counts = [0_u64; OP_KINDS.len()];
+
+    for seed in 0..GATE_SEEDS {
+        let case = undo_gen::generate_case(seed);
+        if !undo_gen::analyse(&case.history, &case.target).independent {
+            continue;
+        }
+        let (multi, later) = coverage(&case);
+        multi_change_targets += u64::from(multi);
+        later_writers += u64::from(later);
+        for (count, seen) in kind_counts.iter_mut().zip(target_op_kinds(&case)) {
+            *count += u64::from(seen);
+        }
+    }
+
+    println!("multi-change targets: {multi_change_targets}, later writers: {later_writers}");
+    assert!(multi_change_targets > 0, "no target made several changes");
+    assert!(later_writers > 0, "no later invocation wrote the document");
+
+    for (name, count) in OP_KINDS.iter().zip(kind_counts) {
+        println!("targets with a {name} op: {count}");
+        assert!(count > 0, "no target had a {name} op");
+    }
+}
+
+const DOC_A: &str = "a";
+const DOC_B: &str = "b";
+
+fn write(store: &mut Store, id: &str, invocation: &str, key: &str, value: &str) {
+    store
+        .edit_content(
+            undo_gen::KIND,
+            id,
+            &undo_gen::stamped(invocation),
+            |tx, root| tx.put(root, key, value),
+        )
+        .unwrap();
+}
+
+/// Two documents, each written by `i1` (the base), the target `i2` and a later `i3`.
+fn two_documents() -> Store {
+    let mut store = Store::new();
+    for id in [DOC_A, DOC_B] {
+        store
+            .put(
+                undo_gen::KIND,
+                id,
+                undo_gen::resource(),
+                &undo_gen::stamped("i1"),
+            )
+            .unwrap();
+        write(&mut store, id, "i1", "base", "base");
+    }
+    for (invocation, key) in [("i2", "target"), ("i3", "later")] {
+        for id in [DOC_A, DOC_B] {
+            write(&mut store, id, invocation, key, &format!("{key}-{id}"));
+        }
+    }
+    store
+}
+
+fn content_of(store: &Store, id: &str) -> Option<JsonValue> {
+    store.content_json(undo_gen::KIND, id)
+}
+
+fn heads(store: &mut Store, id: &str) -> Vec<ChangeHash> {
+    let (doc, _) = store.content(undo_gen::KIND, id).unwrap().unwrap();
+    doc.get_heads()
+}
+
+#[test]
+fn undo_of_a_two_document_invocation_keeps_later_changes() {
+    let mut store = two_documents();
+    install(&mut store);
+
+    store.undo("i2", &undo_gen::undo_stamp("i2")).unwrap();
+
+    assert_eq!(
+        content_of(&store, DOC_A),
+        Some(serde_json::json!({"base": "base", "later": "later-a"}))
+    );
+    assert_eq!(
+        content_of(&store, DOC_B),
+        Some(serde_json::json!({"base": "base", "later": "later-b"}))
+    );
+}
+
+/// Reverts like Tilo's hook, but fails on its second call, whichever document that is. It
+/// records the calls and whether the first one succeeded.
+struct FailsOnSecondCall {
+    calls: Arc<AtomicUsize>,
+    first_succeeded: Arc<AtomicBool>,
+}
+
+impl ContentUndo for FailsOnSecondCall {
+    fn undo(&self, doc: &mut AutoCommit, changes: &[(ChangeHash, String)]) -> Result<(), String> {
+        if self.calls.fetch_add(1, Ordering::SeqCst) == 1 {
+            return Err("second call".to_owned());
+        }
+        RevertContentUndo.undo(doc, changes)?;
+        self.first_succeeded.store(true, Ordering::SeqCst);
+        Ok(())
+    }
+}
+
+#[test]
+fn two_document_undo_is_all_or_nothing() {
+    let mut store = two_documents();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let first_succeeded = Arc::new(AtomicBool::new(false));
+    store.set_content_undo(Box::new(FailsOnSecondCall {
+        calls: Arc::clone(&calls),
+        first_succeeded: Arc::clone(&first_succeeded),
+    }));
+    let heads_before = [heads(&mut store, DOC_A), heads(&mut store, DOC_B)];
+
+    assert!(store.undo("i2", &undo_gen::undo_stamp("i2")).is_err());
+
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    assert!(first_succeeded.load(Ordering::SeqCst));
+    assert_eq!(
+        content_of(&store, DOC_A),
+        Some(serde_json::json!({
+            "base": "base",
+            "target": "target-a",
+            "later": "later-a"
+        }))
+    );
+    assert_eq!(
+        content_of(&store, DOC_B),
+        Some(serde_json::json!({
+            "base": "base",
+            "target": "target-b",
+            "later": "later-b"
+        }))
+    );
+    let heads_after = [heads(&mut store, DOC_A), heads(&mut store, DOC_B)];
+    assert_eq!(heads_after, heads_before);
+}
+
+/// A defective hook: reverts only the first document it is called for and reports success.
+struct FirstDocumentOnly {
+    reverted: AtomicBool,
+}
+
+impl ContentUndo for FirstDocumentOnly {
+    fn undo(&self, doc: &mut AutoCommit, changes: &[(ChangeHash, String)]) -> Result<(), String> {
+        if self.reverted.swap(true, Ordering::SeqCst) {
+            return Ok(());
+        }
+        RevertContentUndo.undo(doc, changes)
+    }
+}
+
+/// What the two documents hold once the target is undone in both.
+fn expected_after_undo() -> (JsonValue, JsonValue) {
+    (
+        serde_json::json!({"base": "base", "later": "later-a"}),
+        serde_json::json!({"base": "base", "later": "later-b"}),
+    )
+}
+
+#[test]
+fn first_document_only_undo_is_detected() {
+    let mut store = two_documents();
+    store.set_content_undo(Box::new(FirstDocumentOnly {
+        reverted: AtomicBool::new(false),
+    }));
+
+    store.undo("i2", &undo_gen::undo_stamp("i2")).unwrap();
+
+    let (expected_a, expected_b) = expected_after_undo();
+    let meets_expectations = content_of(&store, DOC_A) == Some(expected_a)
+        && content_of(&store, DOC_B) == Some(expected_b);
+    assert!(!meets_expectations);
+}
+
+fn history_case(invocations: Vec<(&str, Vec<Op>)>, target: &str) -> Case {
+    Case {
+        history: History {
+            invocations: invocations
+                .into_iter()
+                .map(|(id, ops)| Invocation {
+                    id: id.to_owned(),
+                    ops,
+                })
+                .collect(),
+        },
+        target: target.to_owned(),
+    }
+}
+
+fn insert_item(value: &str, after: Option<&str>) -> Op {
+    Op::Insert {
+        target: "i1:items".to_owned(),
+        after: after.map(str::to_owned),
+        value: value.to_owned(),
+    }
+}
+
+#[test]
+fn replay_without_target_is_hand_checked() {
+    let case = history_case(
+        vec![
+            ("i1", Vec::new()),
+            ("i2", vec![insert_item("v1", None)]),
+            ("i3", vec![insert_item("v2", None)]),
+            ("i4", vec![insert_item("v3", Some("v1")), put_key("k0")]),
+        ],
+        "i3",
+    );
+    let expected = serde_json::json!({"meta": {"props": {"k0": "v-k0"}, "items": ["v1", "v3"]}});
+
+    let replayed = undo_gen::play_history(&case.history, Some("i3")).unwrap();
+
+    assert_eq!(undo_gen::observe(&replayed), expected);
+    assert_eq!(undone(&case), expected);
+}
+
+fn undo_step(store: &mut Store, invocation: &str) {
+    store
+        .undo(invocation, &undo_gen::undo_stamp(invocation))
+        .unwrap();
+}
+
+#[test]
+fn undo_of_an_undo_restores_the_target() {
+    let case = case(vec![put_key("k0")], vec![put_key("k1")]);
+    let mut store = undo_gen::play_history(&case.history, None).unwrap();
+    install(&mut store);
+    assert_eq!(
+        undo_gen::observe(&store),
+        serde_json::json!({"meta": {"props": {"k0": "v-k0", "k1": "v-k1"}, "items": []}})
+    );
+
+    undo_step(&mut store, "i2");
+    assert_eq!(
+        undo_gen::observe(&store),
+        serde_json::json!({"meta": {"props": {"k1": "v-k1"}, "items": []}})
+    );
+
+    // The undo's changes carry the invocation `u-i2`, so it can be undone like any invocation.
+    undo_step(&mut store, "u-i2");
+    assert_eq!(
+        undo_gen::observe(&store),
+        serde_json::json!({"meta": {"props": {"k0": "v-k0", "k1": "v-k1"}, "items": []}})
+    );
+}
+
+fn items_list(tx: &Transaction<'_>, root: &ObjId) -> ObjId {
+    tx.get(root, "items")
+        .unwrap()
+        .expect("the items list exists")
+        .1
+}
+
+#[test]
+fn undo_keeps_a_list_counter_a_later_invocation_replaced() {
+    let mut store = Store::new();
+    install(&mut store);
+    store
+        .put(
+            undo_gen::KIND,
+            undo_gen::ID,
+            undo_gen::resource(),
+            &undo_gen::stamped("i1"),
+        )
+        .unwrap();
+    store
+        .edit_content(
+            undo_gen::KIND,
+            undo_gen::ID,
+            &undo_gen::stamped("i1"),
+            |tx, root| {
+                let items = tx.put_object(root, "items", ObjType::List)?;
+                tx.insert(&items, 0, ScalarValue::counter(0))
+            },
+        )
+        .unwrap();
+    store
+        .edit_content(
+            undo_gen::KIND,
+            undo_gen::ID,
+            &undo_gen::stamped("i2"),
+            |tx, root| {
+                let items = items_list(tx, root);
+                tx.increment(&items, 0_usize, 5)
+            },
+        )
+        .unwrap();
+    store
+        .edit_content(
+            undo_gen::KIND,
+            undo_gen::ID,
+            &undo_gen::stamped("i3"),
+            |tx, root| {
+                let items = items_list(tx, root);
+                tx.put(&items, 0_usize, "replaced")
+            },
+        )
+        .unwrap();
+
+    undo_step(&mut store, "i2");
+
+    assert_eq!(
+        content_of(&store, undo_gen::ID),
+        Some(serde_json::json!({"items": ["replaced"]}))
+    );
+}
+
+/// Admits every change: the test is about what undo keeps, not about who may write.
+struct AllowAll;
+
+impl Admit for AllowAll {
+    fn admit(&self, _: &Proposal<'_>) -> bool {
+        true
+    }
+}
+
+#[test]
+fn undo_keeps_an_edit_delivered_by_receive() {
+    let edit = |store: &mut Store, invocation: &str, key: &str| {
+        store
+            .edit_content(
+                undo_gen::KIND,
+                undo_gen::ID,
+                &undo_gen::stamped(invocation),
+                |tx, root| tx.put(root, key, key),
+            )
+            .unwrap()
+            .1
+            .expect("the edit wrote a change")
+    };
+    let mut store = Store::new();
+    let resource_doc = store
+        .put(
+            undo_gen::KIND,
+            undo_gen::ID,
+            undo_gen::resource(),
+            &undo_gen::stamped("i1"),
+        )
+        .unwrap()
+        .remove(0);
+    edit(&mut store, "i1", "base");
+    let target = edit(&mut store, "i2", "target");
+
+    // A second store starts from the same documents and makes a later edit of its own.
+    let mut other = Store::new();
+    for doc in [&resource_doc.doc, &target.doc] {
+        let bytes = store.document(doc).unwrap().save();
+        other.load(doc, &bytes).unwrap();
+    }
+    let later = edit(&mut other, "i3", "later");
+
+    let refused = store
+        .receive(
+            &target.doc,
+            &target.readers,
+            vec![Received {
+                change: later.change,
+                author: [0; 32],
+            }],
+            &AllowAll,
+        )
+        .unwrap();
+    assert!(refused.is_empty());
+    assert_eq!(
+        content_of(&store, undo_gen::ID),
+        Some(serde_json::json!({"base": "base", "target": "target", "later": "later"}))
+    );
+
+    install(&mut store);
+    undo_step(&mut store, "i2");
+
+    assert_eq!(
+        content_of(&store, undo_gen::ID),
+        Some(serde_json::json!({"base": "base", "later": "later"}))
+    );
+}
diff --git a/crates/server/tilo-workspace-service/tests/selective_undo_text_counter.rs b/crates/server/tilo-workspace-service/tests/selective_undo_text_counter.rs
new file mode 100644
index 0000000000..0b5bab63fa
--- /dev/null
+++ b/crates/server/tilo-workspace-service/tests/selective_undo_text_counter.rs
@@ -0,0 +1,588 @@
+#![cfg(any(feature = "agents", feature = "apps"))]
+#![allow(
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::arithmetic_side_effects,
+    clippy::indexing_slicing,
+    reason = "test assertions and a small generator"
+)]
+
+//! Selective undo of counters and texts, today (no hook) and with Tilo's revert installed: a
+//! seeded generator makes a history, one invocation is undone, and the content is compared with
+//! a replay of the history without it.
+
+use std::env;
+use std::ops::Range;
+
+use automerge::transaction::Transactable as _;
+use automerge::{ObjType, ReadDoc as _, ScalarValue};
+use serde_json::{Value as JsonValue, json};
+use tilo_resource_store::{Resource, Stamp, Store};
+use tilo_workspace_service::workspaces::content_undo::RevertContentUndo;
+
+const DELTAS: [i64; 6] = [-3, -2, -1, 1, 2, 3];
+const BASE: [&str; 4] = ["b0", "b1", "b2", "b3"];
+const GATE_SEEDS: u64 = 1000;
+
+/// A splitmix64 generator: the same seed gives the same history.
+struct Rng(u64);
+
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+
+    fn below(&mut self, n: usize) -> usize {
+        let bound = u64::try_from(n).expect("fits");
+        usize::try_from(self.next() % bound).expect("below n")
+    }
+}
+
+fn seeds() -> u64 {
+    env::var("TILO_SEEDS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(1000)
+}
+
+fn stamp(invocation: &str) -> Stamp {
+    Stamp {
+        invocation: invocation.to_owned(),
+        ..Stamp::default()
+    }
+}
+
+/// The id of the invocation that made operation `index`: `i1` made the base.
+fn invocation(index: usize) -> String {
+    format!("i{}", index + 2)
+}
+
+/// A store holding the note `n1`, with the hook installed or not.
+fn new_store(hook: bool) -> Store {
+    let mut store = Store::new();
+    if hook {
+        store.set_content_undo(Box::new(RevertContentUndo));
+    }
+    let resource = Resource {
+        readers: "*".to_owned(),
+        ..Resource::default()
+    };
+    store.put("note", "n1", resource, &stamp("i1")).unwrap();
+    store
+}
+
+fn field(store: &Store, name: &str) -> Option<JsonValue> {
+    Some(store.content_json("note", "n1")?[name].clone())
+}
+
+// Case 1: counters.
+
+struct CounterCase {
+    deltas: Vec<i64>,
+    target: usize,
+}
+
+impl CounterCase {
+    /// The sum of every increment but the target's.
+    fn expected(&self) -> i64 {
+        let others = self.deltas.iter().enumerate();
+        others
+            .filter(|(index, _)| *index != self.target)
+            .map(|(_, delta)| delta)
+            .sum()
+    }
+}
+
+fn counter_case(seed: u64) -> CounterCase {
+    let mut rng = Rng(seed);
+    let count = 2 + rng.below(5);
+    let deltas = (0..count)
+        .map(|_| DELTAS[rng.below(DELTAS.len())])
+        .collect();
+    CounterCase {
+        deltas,
+        target: rng.below(count),
+    }
+}
+
+fn counter_store(case: &CounterCase, hook: bool) -> Store {
+    let mut store = new_store(hook);
+    store
+        .edit_content("note", "n1", &stamp("i1"), |tx, root| {
+            tx.put(root, "count", ScalarValue::counter(0))
+        })
+        .unwrap();
+    for (index, delta) in case.deltas.iter().enumerate() {
+        store
+            .edit_content("note", "n1", &stamp(&invocation(index)), |tx, root| {
+                tx.increment(root, "count", *delta)
+            })
+            .unwrap();
+    }
+    store
+}
+
+fn count(store: &Store) -> Option<i64> {
+    field(store, "count")?.as_i64()
+}
+
+/// The count after undoing the target; `None` when the undo fails.
+fn undone_count(case: &CounterCase, hook: bool) -> Option<i64> {
+    let mut store = counter_store(case, hook);
+    let undo = stamp("undo");
+    store.undo(&invocation(case.target), &undo).ok()?;
+    count(&store)
+}
+
+fn counter_example(case: &CounterCase, expected: i64, got: Option<i64>) -> JsonValue {
+    json!({
+        "deltas": case.deltas,
+        "target": invocation(case.target),
+        "expected": expected,
+        "got": got,
+    })
+}
+
+// Case 2: texts. A text is words, each followed by a space.
+
+#[derive(Debug)]
+enum Op {
+    Insert { after: String, word: String },
+    Delete { word: String },
+}
+
+struct TextCase {
+    ops: Vec<Op>,
+    target: usize,
+}
+
+fn base_words() -> Vec<String> {
+    BASE.iter().map(|word| (*word).to_owned()).collect()
+}
+
+fn render(words: &[String]) -> String {
+    words
+        .iter()
+        .fold(String::new(), |text, word| text + word + " ")
+}
+
+fn offset(words: &[String]) -> usize {
+    words.iter().map(|word| word.len() + 1).sum()
+}
+
+/// Applies `op` to the words and answers the splice (position, deleted length, inserted text)
+/// that makes the same change to the text.
+fn step(words: &mut Vec<String>, op: &Op) -> (usize, usize, String) {
+    match op {
+        Op::Insert { after, word } => {
+            let index = words
+                .iter()
+                .position(|other| other == after)
+                .map_or(0, |at| at + 1);
+            let at = offset(&words[..index]);
+            words.insert(index, word.clone());
+            (at, 0, format!("{word} "))
+        }
+        Op::Delete { word } => {
+            let index = words
+                .iter()
+                .position(|other| other == word)
+                .expect("a deleted word is present");
+            let at = offset(&words[..index]);
+            words.remove(index);
+            (at, word.len() + 1, String::new())
+        }
+    }
+}
+
+/// Either deletes a base word (never the last word) or inserts a new unique word after any word.
+fn next_op(rng: &mut Rng, words: &[String], n: usize) -> Op {
+    let deletable: Vec<&String> = words.iter().filter(|word| word.starts_with('b')).collect();
+    if words.len() > 1 && !deletable.is_empty() && rng.below(2) == 0 {
+        return Op::Delete {
+            word: deletable[rng.below(deletable.len())].clone(),
+        };
+    }
+    Op::Insert {
+        after: words[rng.below(words.len())].clone(),
+        word: format!("n{n}"),
+    }
+}
+
+fn text_case(seed: u64) -> TextCase {
+    let mut rng = Rng(seed);
+    let count = 2 + rng.below(4);
+    let mut words = base_words();
+    let mut ops = Vec::new();
+    for n in 0..count {
+        let op = next_op(&mut rng, &words, n);
+        step(&mut words, &op);
+        ops.push(op);
+    }
+    TextCase {
+        ops,
+        target: rng.below(count),
+    }
+}
+
+/// The words next to `word` just before the target ran.
+fn neighbours(case: &TextCase, word: &str) -> Vec<String> {
+    let mut words = base_words();
+    for op in &case.ops[..case.target] {
+        step(&mut words, op);
+    }
+    let at = words.iter().position(|other| other == word).unwrap();
+    [at.checked_sub(1), Some(at + 1)]
+        .into_iter()
+        .flatten()
+        .filter_map(|index| words.get(index).cloned())
+        .collect()
+}
+
+fn touches(op: &Op, word: &str) -> bool {
+    match op {
+        Op::Insert { after, .. } => after == word,
+        Op::Delete { word: gone } => gone == word,
+    }
+}
+
+/// No later operation builds on a word the target inserted or deletes next to one it deleted.
+fn independent(case: &TextCase) -> bool {
+    let later = &case.ops[case.target + 1..];
+    match &case.ops[case.target] {
+        Op::Insert { word, .. } => !later.iter().any(|op| touches(op, word)),
+        Op::Delete { word } => {
+            let near = neighbours(case, word);
+            !later
+                .iter()
+                .any(|op| matches!(op, Op::Delete { word: gone } if near.contains(gone)))
+        }
+    }
+}
+
+fn text_store(case: &TextCase, hook: bool) -> Store {
+    let mut store = new_store(hook);
+    let mut words = base_words();
+    let text = render(&words);
+    store
+        .edit_content("note", "n1", &stamp("i1"), |tx, root| {
+            let body = tx.put_object(root, "body", ObjType::Text)?;
+            tx.splice_text(&body, 0, 0, &text)
+        })
+        .unwrap();
+    for (index, op) in case.ops.iter().enumerate() {
+        let (at, deleted, inserted) = step(&mut words, op);
+        store
+            .edit_content("note", "n1", &stamp(&invocation(index)), |tx, root| {
+                let (_, body) = tx.get(root, "body")?.expect("the body exists");
+                // The parameter's integer type differs between automerge versions.
+                tx.splice_text(&body, at, deleted.try_into().unwrap(), &inserted)
+            })
+            .unwrap();
+    }
+    store
+}
+
+fn body(store: &Store) -> Option<String> {
+    field(store, "body")?.as_str().map(str::to_owned)
+}
+
+/// The text after undoing the target; `None` when the undo fails.
+fn undone_body(case: &TextCase, hook: bool) -> Option<String> {
+    let mut store = text_store(case, hook);
+    let undo = stamp("undo");
+    store.undo(&invocation(case.target), &undo).ok()?;
+    body(&store)
+}
+
+/// The text of a replay of the history without the target.
+fn replay_without_target(case: &TextCase) -> String {
+    let mut words = base_words();
+    for (index, op) in case.ops.iter().enumerate() {
+        if index != case.target {
+            step(&mut words, op);
+        }
+    }
+    render(&words)
+}
+
+enum Outcome {
+    Holds,
+    OrderOnly,
+    Violated,
+}
+
+fn sorted_words(text: &str) -> Vec<&str> {
+    let mut words: Vec<&str> = text.split_whitespace().collect();
+    words.sort_unstable();
+    words
+}
+
+/// The word the target inserted or deleted.
+fn target_word(case: &TextCase) -> &str {
+    match &case.ops[case.target] {
+        Op::Insert { word, .. } | Op::Delete { word } => word,
+    }
+}
+
+fn without<'a>(text: &'a str, word: &str) -> Vec<&'a str> {
+    text.split_whitespace()
+        .filter(|other| *other != word)
+        .collect()
+}
+
+/// The target's own word may land elsewhere (a restored word next to a later insert); every
+/// other word has to keep its place.
+fn classify(got: Option<&str>, expected: &str, moved: &str) -> Outcome {
+    match got {
+        Some(text) if text == expected => Outcome::Holds,
+        Some(text)
+            if sorted_words(text) == sorted_words(expected)
+                && without(text, moved) == without(expected, moved) =>
+        {
+            Outcome::OrderOnly
+        }
+        _ => Outcome::Violated,
+    }
+}
+
+fn text_example(case: &TextCase, expected: &str, got: Option<&str>) -> JsonValue {
+    json!({
+        "ops": case.ops.iter().map(|op| format!("{op:?}")).collect::<Vec<_>>(),
+        "target": invocation(case.target),
+        "expected": expected,
+        "got": got,
+    })
+}
+
+#[test]
+fn a_played_counter_history_reads_back_as_the_sum() {
+    let case = counter_case(7);
+
+    let store = counter_store(&case, false);
+
+    assert_eq!(count(&store), Some(case.deltas.iter().sum()));
+}
