+#![allow(
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::indexing_slicing,
+    reason = "test assertions"
+)]
+
+//! The store's content-undo hook: what `Store::undo` answers when the injected hook fails, writes
+//! nothing, writes more than one change, or writes one inverse change.
+
+use std::collections::BTreeMap;
+use std::sync::{Arc, Mutex};
+
+use automerge::transaction::Transactable as _;
+use automerge::{AutoCommit, ChangeHash, ROOT, ReadDoc as _};
+use serde_json::json;
+use tilo_resource_store::store::StoreError;
+use tilo_resource_store::{ContentUndo, Resource, Stamp, Store};
+
+/// A hook that runs `body` on the document and ignores which changes it is asked to undo.
+struct Hook(fn(&mut AutoCommit) -> Result<(), String>);
+
+impl ContentUndo for Hook {
+    fn undo(&self, doc: &mut AutoCommit, _: &[(ChangeHash, String)]) -> Result<(), String> {
+        (self.0)(doc)
+    }
+}
+
+fn stamp(invocation: &str) -> Stamp {
+    Stamp {
+        invocation: invocation.to_owned(),
+        ..Stamp::default()
+    }
+}
+
+/// A store with the note `n1` whose content was edited by the invocation `a`, undone by `hook`;
+/// answers the store and the content document's id.
+fn edited(hook: Hook) -> (Store, String) {
+    edited_in(Store::new(), hook)
+}
+
+/// As [`edited`], in `store`.
+fn edited_in(mut store: Store, hook: Hook) -> (Store, String) {
+    store.set_content_undo(Box::new(hook));
+    let resource = Resource {
+        readers: "*".to_owned(),
+        ..Resource::default()
+    };
+    store.put("note", "n1", resource, &stamp("setup")).unwrap();
+    let ((), written) = store
+        .edit_content("note", "n1", &stamp("a"), |tx, root| {
+            tx.put(root, "meta", "1")
+        })
+        .unwrap();
+    (store, written.unwrap().doc)
+}
+
+fn content(store: &Store) -> Option<serde_json::Value> {
+    store.content_json("note", "n1")
+}
+
+fn heads(store: &Store, doc: &str) -> Vec<ChangeHash> {
+    store.document(doc).unwrap().get_heads()
+}
+
+#[test]
+fn a_hook_that_fails_makes_the_undo_fail_and_leaves_the_content() {
+    let (mut store, doc) = edited(Hook(|_| Err("nope".to_owned())));
+    let before = (content(&store), heads(&store, &doc));
+
+    let error = store.undo("a", &stamp("undo-a")).unwrap_err();
+
+    assert!(matches!(&error, StoreError::Undo(reason) if reason.contains("nope")));
+    assert_eq!((content(&store), heads(&store, &doc)), before);
+}
+
+#[test]
+fn a_hook_that_writes_nothing_gives_no_write() {
+    let (mut store, doc) = edited(Hook(|_| Ok(())));
+    let before = (content(&store), heads(&store, &doc));
+
+    let written = store.undo("a", &stamp("undo-a")).unwrap();
+
+    assert!(written.is_empty());
+    assert_eq!((content(&store), heads(&store, &doc)), before);
+}
+
+#[test]
+fn a_hook_that_commits_twice_is_refused_and_leaves_the_content() {
+    let (mut store, doc) = edited(Hook(|doc| {
+        doc.put(ROOT, "first", 1)
+            .map_err(|error| error.to_string())?;
+        doc.commit();
+        doc.put(ROOT, "second", 2)
+            .map_err(|error| error.to_string())
+    }));
+    let before = (content(&store), heads(&store, &doc));
+
+    let error = store.undo("a", &stamp("undo-a")).unwrap_err();
+
+    assert!(matches!(&error, StoreError::Undo(reason) if reason.contains("more than one change")));
+    assert_eq!((content(&store), heads(&store, &doc)), before);
+}
+
+#[test]
+fn a_hook_that_writes_one_change_shows_in_the_content_with_one_write() {
+    let (mut store, doc) = edited(Hook(|doc| {
+        doc.put(ROOT, "meta", "undone")
+            .map_err(|error| error.to_string())
+    }));
+    let before = heads(&store, &doc);
+
+    let written = store.undo("a", &stamp("undo-a")).unwrap();
+
+    assert_eq!(content(&store), Some(json!({"meta": "undone"})));
+    assert_eq!(written.len(), 1);
+    assert_eq!(written[0].doc, doc);
+    assert_ne!(heads(&store, &doc), before);
+}
+
+#[test]
+fn a_hook_that_fails_on_a_later_note_leaves_every_note() {
+    let mut store = Store::new();
+    store.set_content_undo(Box::new(Hook(|doc| {
+        if doc
+            .get(ROOT, "fail")
+            .map_err(|error| error.to_string())?
+            .is_some()
+        {
+            return Err("marked".to_owned());
+        }
+        doc.put(ROOT, "meta", "undone")
+            .map_err(|error| error.to_string())
+    })));
+    for id in ["n1", "n2"] {
+        let resource = Resource {
+            readers: "*".to_owned(),
+            ..Resource::default()
+        };
+        store.put("note", id, resource, &stamp("setup")).unwrap();
+        store
+            .edit_content("note", id, &stamp("a"), |tx, root| {
+                tx.put(root, "meta", "1")
+            })
+            .unwrap();
+    }
+    store
+        .edit_content("note", "n2", &stamp("b"), |tx, root| {
+            tx.put(root, "fail", true)
+        })
+        .unwrap();
+
+    let error = store.undo("a", &stamp("undo-a")).unwrap_err();
+
+    assert!(matches!(error, StoreError::Undo(_)));
+    assert_eq!(store.content_json("note", "n1"), Some(json!({"meta": "1"})));
+    assert_eq!(
+        store.content_json("note", "n2"),
+        Some(json!({"fail": true, "meta": "1"}))
+    );
+}
+
+/// A hook that fails on a content marked with a `fail` key and otherwise writes one change.
+fn fail_if_marked(doc: &mut AutoCommit) -> Result<(), String> {
+    if doc
+        .get(ROOT, "fail")
+        .map_err(|error| error.to_string())?
+        .is_some()
+    {
+        return Err("marked".to_owned());
+    }
+    doc.put(ROOT, "meta", "undone")
+        .map_err(|error| error.to_string())
+}
+
+fn everyone() -> Resource {
+    Resource {
+        readers: "*".to_owned(),
+        ..Resource::default()
+    }
+}
+
+/// The notes `n1` and `n2`, whose contents invocation `a` edited, and the resource `n3` it made;
+/// then `marked` is marked by `b`, so the hook fails on it.
+fn made_and_edited(marked: &str) -> Store {
+    let mut store = Store::new();
+    store.set_content_undo(Box::new(Hook(fail_if_marked)));
+    for id in ["n1", "n2"] {
+        store.put("note", id, everyone(), &stamp("setup")).unwrap();
+    }
+    store.put("note", "n3", everyone(), &stamp("a")).unwrap();
+    for id in ["n1", "n2"] {
+        store
+            .edit_content("note", id, &stamp("a"), |tx, root| {
+                tx.put(root, "meta", "1")
+            })
+            .unwrap();
+    }
+    store
+        .edit_content("note", marked, &stamp("b"), |tx, root| {
+            tx.put(root, "fail", true)
+        })
+        .unwrap();
+    store
+}
+
+#[derive(Debug, PartialEq)]
+struct Note {
+    resource: Option<(String, Option<String>, Option<String>)>,
+    readers: Option<String>,
+    content: Option<serde_json::Value>,
+}
+
+/// What a failed undo must leave alone.
+#[derive(Debug, PartialEq)]
+struct State {
+    heads: BTreeMap<String, Vec<ChangeHash>>,
+    notes: Vec<Note>,
+    removed: Vec<String>,
+}
+
+fn note(store: &Store, id: &str) -> Note {
+    let held = store.get("note", id, &|_| true);
+    Note {
+        resource: held.map(|held| (held.doc.clone(), held.parent.clone(), held.order.clone())),
+        readers: held
+            .and_then(|held| store.index().readers(&held.doc))
+            .map(str::to_owned),
+        content: store.content_json("note", id),
+    }
+}
+
+fn state(store: &Store) -> State {
+    State {
+        heads: store
+            .index()
+            .documents()
+            .filter_map(|doc| Some((doc.to_owned(), store.document(doc)?.get_heads())))
+            .collect(),
+        notes: ["n1", "n2", "n3"]
+            .iter()
+            .map(|id| note(store, id))
+            .collect(),
+        removed: store.removed("note", None, &|_| true),
+    }
+}
+
+fn assert_failed_undo_changes_nothing(marked: &str) {
+    let mut store = made_and_edited(marked);
+    let before = state(&store);
+    assert!(before.notes[2].resource.is_some());
+    let removed_before = store.removed("note", None, &|_| true);
+
+    let error = store.undo("a", &stamp("undo-a")).unwrap_err();
+
+    assert!(matches!(error, StoreError::Undo(reason) if reason.contains("marked")));
+    assert_eq!(state(&store), before);
+    // A resource the failed undo removed and the rollback put back is not listed as removed.
+    assert_eq!(store.removed("note", None, &|_| true), removed_before);
+}
+
+#[test]
+fn a_failed_undo_restores_a_resource_it_removed_and_every_note_when_n2_fails() {
+    assert_failed_undo_changes_nothing("n2");
+}
+
+#[test]
+fn a_failed_undo_restores_a_resource_it_removed_and_every_note_when_n1_fails() {
+    assert_failed_undo_changes_nothing("n1");
+}
+
+#[test]
+fn a_watch_and_count_made_before_a_failed_undo_answer_the_same_after() {
+    let mut store = made_and_edited("n2");
+    let watch = store.watch("note");
+    let before = store.count("note", &[], &|_| true);
+    assert_eq!(before, 3);
+
+    store.undo("a", &stamp("undo-a")).unwrap_err();
+
+    assert_eq!(store.count("note", &[], &|_| true), before);
+    // A change notice is allowed, and only for this watch.
+    assert!(store.changed().iter().all(|changed| *changed == watch));
+}
+
+#[test]
+fn a_drafted_undo_uses_the_hook_and_leaves_the_store_and_its_hook() {
+    use tilo_resource_store::wire::{Command, draft};
+    let (mut store, doc) = edited(Hook(|doc| {
+        doc.put(ROOT, "meta", "undone")
+            .map_err(|error| error.to_string())
+    }));
+    let before = (content(&store), heads(&store, &doc));
+    let undo = || Command::Undo {
+        invocation: "a".to_owned(),
+        stamp: stamp("undo-a"),
+    };
+
+    let drafted = draft(&mut store, undo()).unwrap();
+
+    assert_eq!(drafted.len(), 1);
+    let mut staged = store.document(&doc).unwrap().clone();
+    staged.apply_changes([drafted[0].change.clone()]).unwrap();
+    let meta = staged.get(ROOT, "meta").unwrap().unwrap().0;
+    assert_eq!(meta.into_string().unwrap(), "undone");
+    assert_eq!((content(&store), heads(&store, &doc)), before);
+    store.undo("a", &stamp("undo-a")).unwrap();
+    assert_eq!(content(&store), Some(json!({"meta": "undone"})));
+}
+
+#[test]
+fn an_evicted_content_is_read_again_from_the_source_and_undone_with_the_hook() {
+    let saved: Arc<Mutex<Option<Vec<u8>>>> = Arc::default();
+    let source = Arc::clone(&saved);
+    let store = Store::with_source(Box::new(move |_| source.lock().unwrap().clone()));
+    let (mut store, doc) = edited_in(
+        store,
+        Hook(|doc| {
+            doc.put(ROOT, "meta", "undone")
+                .map_err(|error| error.to_string())
+        }),
+    );
+    *saved.lock().unwrap() = store.evict(&doc);
+    assert!(store.document(&doc).is_none());
+
+    let written = store.undo("a", &stamp("undo-a")).unwrap();
+
+    assert_eq!(written.len(), 1);
+    assert_eq!(content(&store), Some(json!({"meta": "undone"})));
+}
+
+/// Panics the first time it is asked, then writes `meta = "undone"`.
+struct PanicsOnce(std::sync::atomic::AtomicBool);
+
+impl ContentUndo for PanicsOnce {
+    #[allow(clippy::panic_in_result_fn, reason = "panicking is this double's job")]
+    fn undo(&self, doc: &mut AutoCommit, _: &[(ChangeHash, String)]) -> Result<(), String> {
+        assert!(
+            self.0.swap(true, std::sync::atomic::Ordering::SeqCst),
+            "first call panics"
+        );
+        doc.put(ROOT, "meta", "undone")
+            .map_err(|error| error.to_string())
+    }
+}
+
+#[test]
+fn a_draft_that_panics_leaves_the_hook_in_the_live_store() {
+    use tilo_resource_store::wire::{Command, draft};
+    let (mut store, _) = edited(Hook(|_| Ok(())));
+    store.set_content_undo(Box::new(PanicsOnce(std::sync::atomic::AtomicBool::new(
+        false,
+    ))));
+    let undo = Command::Undo {
+        invocation: "a".to_owned(),
+        stamp: stamp("undo-a"),
+    };
+
+    let panicked =
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| draft(&mut store, undo)));
+
+    assert!(panicked.is_err());
+    store.undo("a", &stamp("undo-a")).unwrap();
+    assert_eq!(content(&store), Some(json!({"meta": "undone"})));
+}
