+const GATE_SEEDS: u64 = 1000;
+
+fn gate(authors: Authors) {
+    let counts = count_range(authors, 0..GATE_SEEDS);
+    assert!(
+        counts.independent > 0,
+        "no independent histories were generated"
+    );
+    assert_eq!(counts.replay_errors, 0, "histories failed to replay");
+    assert_eq!(
+        counts.violations,
+        0,
+        "first counterexample: {}",
+        serde_json::json!(
+            counts
+                .counterexamples
+                .first()
+                .map(undo_gen::counterexample_json)
+        )
+    );
+}
+
+#[test]
+fn gate_selective_revert_distinct_actors() {
+    gate(Authors::Distinct);
+}
+
+#[test]
+fn gate_selective_revert_single_actor() {
+    gate(Authors::Single);
+}
+
+#[test]
+#[ignore = "a measurement: run it by name"]
+fn measure_selective_revert() {
+    let seeds = env::var("TILO_SEEDS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(2000);
+
+    let output = serde_json::json!({
+        "distinct_actors": measure(Authors::Distinct, seeds),
+        "single_actor": measure(Authors::Single, seeds),
+    });
+
+    println!("{output}");
+}
