diff --git a/crates/collab/collaboration/tests/selective_revert.rs b/crates/collab/collaboration/tests/selective_revert.rs
new file mode 100644
index 0000000000..14f5f08b2d
--- /dev/null
+++ b/crates/collab/collaboration/tests/selective_revert.rs
@@ -0,0 +1,851 @@
+#![allow(
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::arithmetic_side_effects,
+    clippy::panic,
+    reason = "test assertions and a small generator"
+)]
+
+//! Tilo's own `revert_changes` on the histories the selective-undo generator makes: one
+//! invocation is reverted in a plain automerge document, and the result is compared with a
+//! replay of the history without that invocation.
+
+use std::collections::HashMap;
+use std::env;
+use std::ops::Range;
+
+use automerge::transaction::Transactable as _;
+use automerge::{
+    ActorId, AutoCommit, AutomergeError, ChangeHash, ObjId, ObjType, ROOT, ReadDoc as _,
+    ScalarValue, Value,
+};
+use collaboration::history_source::authors::{HistoryAuthor, ResolveAuthor};
+use collaboration::history_source::revert::revert_changes;
+use serde_json::Value as JsonValue;
+use tilo_automerge::ApplyIncoming as _;
+
+#[allow(dead_code, reason = "the generator serves more than one checker")]
+#[path = "../../resource-store/tests/selective_undo.rs"]
+mod undo_gen;
+
+/// Names every actor by its hex, as the workspace service's content undo does.
+struct ActorNamed;
+
+impl ResolveAuthor for ActorNamed {
+    fn resolve(&self, actor: &str) -> HistoryAuthor {
+        HistoryAuthor::new(actor, 0.0, actor)
+    }
+}
+
+/// Whose actor id each invocation writes under.
+#[derive(Clone, Copy)]
+enum Authors {
+    /// One actor per invocation: later writers are other people.
+    Distinct,
+    /// One actor for everything: Tilo's same-author exemption applies.
+    Single,
+}
+
+fn actor_for(authors: Authors, invocation: &str) -> ActorId {
+    match authors {
+        Authors::Distinct => ActorId::from(invocation.as_bytes()),
+        Authors::Single => ActorId::from(b"writer".as_slice()),
+    }
+}
+
+/// A document being built invocation by invocation, with the generator's bookkeeping.
+struct Built {
+    doc: AutoCommit,
+    containers: HashMap<String, ObjId>,
+    list_values: HashMap<String, Vec<String>>,
+    model: undo_gen::Model,
+    /// Each invocation's changes with the actor hex that wrote them, oldest first.
+    changes: HashMap<String, Vec<(ChangeHash, String)>>,
+}
+
+impl Built {
+    fn new(actor: ActorId) -> Result<Self, AutomergeError> {
+        let mut doc = AutoCommit::new().with_actor(actor);
+        let mut containers = HashMap::new();
+        create_base(&mut doc, &mut containers)?;
+        doc.commit();
+        Ok(Self {
+            doc,
+            containers,
+            list_values: HashMap::new(),
+            model: undo_gen::base_model(),
+            changes: HashMap::new(),
+        })
+    }
+
+    fn run(&mut self, invocation: &undo_gen::Invocation, actor: ActorId) -> Result<(), String> {
+        let hex = actor.to_hex_string();
+        self.doc.set_actor(actor);
+        for op in &invocation.ops {
+            self.apply_op(op).map_err(|error| error.to_string())?;
+            undo_gen::apply_model(&mut self.model, op);
+        }
+        if let Some(hash) = self.doc.commit() {
+            self.changes
+                .entry(invocation.id.clone())
+                .or_default()
+                .push((hash, hex));
+        }
+        Ok(())
+    }
+
+    fn apply_op(&mut self, op: &undo_gen::Op) -> Result<(), AutomergeError> {
+        use undo_gen::Op;
+        match op {
+            Op::PutKey { target, key, value } => {
+                let map = undo_gen::lookup_container(&self.containers, target)?;
+                self.doc.put(&map, key.as_str(), value.as_str())?;
+            }
+            Op::DeleteKey { target, key } => {
+                let map = undo_gen::lookup_container(&self.containers, target)?;
+                self.doc.delete(&map, key.as_str())?;
+            }
+            Op::Insert {
+                target,
+                after,
+                value,
+            } => {
+                let list = undo_gen::lookup_container(&self.containers, target)?;
+                let entries = self.list_values.entry(target.clone()).or_default();
+                let index = insert_index(&self.model.lists, target, after.as_deref(), entries);
+                self.doc.insert(&list, index, value.as_str())?;
+                entries.insert(index, value.clone());
+            }
+            Op::Delete { target, value } => {
+                let list = undo_gen::lookup_container(&self.containers, target)?;
+                let entries = self.list_values.entry(target.clone()).or_default();
+                if let Some(index) = entries.iter().position(|item| item == value) {
+                    self.doc.delete(&list, index)?;
+                    entries.remove(index);
+                }
+            }
+            Op::CreateMap { parent, key, name } => {
+                let parent = undo_gen::lookup_container(&self.containers, parent)?;
+                let made = self.doc.put_object(&parent, key.as_str(), ObjType::Map)?;
+                self.containers.insert(name.clone(), made);
+            }
+            Op::CreateList { parent, key, name } => {
+                let parent = undo_gen::lookup_container(&self.containers, parent)?;
+                let made = self.doc.put_object(&parent, key.as_str(), ObjType::List)?;
+                self.containers.insert(name.clone(), made);
+                self.list_values.insert(name.clone(), Vec::new());
+            }
+        }
+        Ok(())
+    }
+}
+
+/// The structure `play_history` creates: a content map holding `meta` with `props` and `items`.
+fn create_base(
+    doc: &mut AutoCommit,
+    containers: &mut HashMap<String, ObjId>,
+) -> Result<(), AutomergeError> {
+    containers.insert(undo_gen::ROOT_LABEL.to_owned(), ROOT);
+    let meta = doc.put_object(ROOT, "meta", ObjType::Map)?;
+    let props = doc.put_object(&meta, "props", ObjType::Map)?;
+    let items = doc.put_object(&meta, "items", ObjType::List)?;
+    containers.insert("i1:meta".to_owned(), meta);
+    containers.insert("i1:props".to_owned(), props);
+    containers.insert("i1:items".to_owned(), items);
+    Ok(())
+}
+
+/// Where an element goes after `after`, as `play_history` places it.
+fn insert_index(
+    generator_lists: &std::collections::BTreeMap<String, Vec<String>>,
+    target: &str,
+    after: Option<&str>,
+    entries: &[String],
+) -> usize {
+    let Some(after) = after else {
+        return 0;
+    };
+    match entries.iter().position(|item| item == after) {
+        Some(position) => position + 1,
+        None => undo_gen::fallback_insert_index(generator_lists, target, after, entries),
+    }
+}
+
+fn build(history: &undo_gen::History, authors: Authors) -> Result<Built, String> {
+    let mut built = Built::new(actor_for(authors, "i1")).map_err(|error| error.to_string())?;
+    for invocation in history.invocations.iter().filter(|i| i.id != "i1") {
+        built.run(invocation, actor_for(authors, &invocation.id))?;
+    }
+    Ok(built)
+}
+
+/// Reverts the target's changes, newest first, and commits the result.
+fn revert_target(built: &mut Built, target: &str) -> Result<(), String> {
+    let mut changes = built.changes.get(target).cloned().unwrap_or_default();
+    changes.reverse();
+    built.doc.set_actor(ActorId::from(b"undo".as_slice()));
+    revert_changes(&mut built.doc, &changes, &ActorNamed).map_err(|error| format!("{error:?}"))?;
+    built.doc.commit();
+    Ok(())
+}
+
+/// The same canonical shape as `undo_gen::observe`.
+fn render(doc: &AutoCommit, obj: &ObjId) -> JsonValue {
+    match doc.object_type(obj) {
+        Ok(ObjType::Map | ObjType::Table) => JsonValue::Object(
+            doc.keys(obj)
+                .map(|key| {
+                    let found = doc.get(obj, key.as_str());
+                    (key, render_entry(doc, found))
+                })
+                .collect(),
+        ),
+        Ok(ObjType::List) => JsonValue::Array(
+            (0..doc.length(obj))
+                .map(|index| render_entry(doc, doc.get(obj, index)))
+                .collect(),
+        ),
+        Ok(ObjType::Text) => JsonValue::String(doc.text(obj).unwrap_or_default()),
+        Err(_) => JsonValue::Null,
+    }
+}
+
+fn render_entry(
+    doc: &AutoCommit,
+    found: Result<Option<(Value<'_>, ObjId)>, AutomergeError>,
+) -> JsonValue {
+    match found {
+        Ok(Some((Value::Object(_), id))) => render(doc, &id),
+        Ok(Some((Value::Scalar(scalar), _))) => match scalar.as_ref() {
+            ScalarValue::Str(text) => JsonValue::String(text.to_string()),
+            _ => JsonValue::Null,
+        },
+        _ => JsonValue::Null,
+    }
+}
+
+/// Whether reverting the target leaves what a replay without it gives.
+fn revert_matches_replay(case: &undo_gen::Case, authors: Authors) -> Result<bool, String> {
+    let mut built = build(&case.history, authors)?;
+    revert_target(&mut built, &case.target)?;
+    let without = undo_gen::play_history(&case.history, Some(&case.target))?;
+    Ok(render(&built.doc, &ROOT) == undo_gen::observe(&without))
+}
+
+/// What a run over a range of seeds found.
+struct Counts {
+    independent: u64,
+    violations: u64,
+    replay_errors: u64,
+    counterexamples: Vec<undo_gen::Case>,
+}
+
+/// The shrinker in the generator is tied to the store's undo, so counterexamples are unshrunk.
+fn count_range(authors: Authors, seeds: Range<u64>) -> Counts {
+    let mut independent = 0_u64;
+    let mut violations = 0_u64;
+    let mut replay_errors = 0_u64;
+    let mut counterexamples = Vec::new();
+
+    for seed in seeds {
+        let case = undo_gen::generate_case(seed);
+        if !undo_gen::analyse(&case.history, &case.target).independent {
+            continue;
+        }
+        independent += 1;
+        match revert_matches_replay(&case, authors) {
+            Ok(true) => {}
+            Ok(false) => {
+                violations += 1;
+                counterexamples.push(case);
+            }
+            Err(_) => replay_errors += 1,
+        }
+    }
+
+    counterexamples.sort_by_key(undo_gen::case_size);
+    Counts {
+        independent,
+        violations,
+        replay_errors,
+        counterexamples,
+    }
+}
+
+fn measure(authors: Authors, seeds: u64) -> JsonValue {
+    let counts = count_range(authors, 0..seeds);
+    serde_json::json!({
+        "histories": seeds,
+        "independent": counts.independent,
+        "p1_violations": counts.violations,
+        "replay_errors": counts.replay_errors,
+        "p1_counterexamples": counts
+            .counterexamples
+            .iter()
+            .take(3)
+            .map(undo_gen::counterexample_json)
+            .collect::<Vec<_>>(),
+    })
+}
+
+#[test]
+fn automerge_build_renders_like_the_store_replay() {
+    for seed in 0..50 {
+        let case = undo_gen::generate_case(seed);
+        let built = build(&case.history, Authors::Distinct).expect("history builds");
+        let store = undo_gen::play_history(&case.history, None).expect("history replays");
+        assert_eq!(
+            render(&built.doc, &ROOT),
+            undo_gen::observe(&store),
+            "seed {seed}"
+        );
+    }
+}
+
+/// Commits what `write` does under the actor named `name`, with the actor's hex.
+fn commit_as(
+    doc: &mut AutoCommit,
+    name: &str,
+    write: impl FnOnce(&mut AutoCommit),
+) -> (ChangeHash, String) {
+    let actor = ActorId::from(name.as_bytes());
+    let hex = actor.to_hex_string();
+    doc.set_actor(actor);
+    write(doc);
+    (doc.commit().expect("a change"), hex)
+}
+
+fn count_of(doc: &AutoCommit) -> i64 {
+    match doc.get(ROOT, "count").unwrap().unwrap().0 {
+        Value::Scalar(scalar) => match scalar.as_ref() {
+            ScalarValue::Counter(counter) => i64::from(counter),
+            other => panic!("not a counter: {other:?}"),
+        },
+        Value::Object(_) => panic!("not a counter"),
+    }
+}
+
+fn counter_doc() -> AutoCommit {
+    let mut doc = AutoCommit::new();
+    commit_as(&mut doc, "base", |doc| {
+        doc.put(ROOT, "count", ScalarValue::counter(0)).unwrap();
+    });
+    doc
+}
+
+fn increment_by(by: i64) -> impl FnOnce(&mut AutoCommit) {
+    move |doc| doc.increment(ROOT, "count", by).unwrap()
+}
+
+/// Reverts the run as `revert_target` does and returns what it kept and whether it wrote.
+fn revert_run_wrote(doc: &mut AutoCommit, run: (ChangeHash, String)) -> (usize, bool) {
+    doc.set_actor(ActorId::from(b"undo".as_slice()));
+    let outcomes = revert_changes(doc, &[run], &ActorNamed).unwrap();
+    doc.commit();
+    let kept = outcomes.iter().map(|outcome| outcome.kept.len()).sum();
+    (kept, outcomes.iter().any(|outcome| outcome.wrote))
+}
+
+/// Reverts the run as `revert_target` does and returns what it kept.
+fn revert_run(doc: &mut AutoCommit, run: (ChangeHash, String)) -> usize {
+    revert_run_wrote(doc, run).0
+}
+
+#[test]
+fn an_increment_is_taken_back_beside_another_authors_increment() {
+    let mut doc = counter_doc();
+    let run = commit_as(&mut doc, "a", increment_by(5));
+    commit_as(&mut doc, "b", increment_by(-2));
+    assert_eq!(revert_run(&mut doc, run), 0);
+    assert_eq!(count_of(&doc), -2);
+}
+
+#[test]
+fn a_concurrent_increment_by_another_author_is_kept() {
+    let mut doc = counter_doc();
+    let mut peer = doc.fork();
+    let run = commit_as(&mut doc, "a", increment_by(5));
+    commit_as(&mut peer, "b", increment_by(-2));
+    doc.merge_incoming(&mut peer).unwrap();
+    assert_eq!(revert_run(&mut doc, run), 0);
+    assert_eq!(count_of(&doc), -2);
+}
+
+#[test]
+fn a_counter_made_by_the_run_stays_when_another_author_incremented_it() {
+    let mut doc = AutoCommit::new();
+    let run = commit_as(&mut doc, "a", |doc| {
+        doc.put(ROOT, "count", ScalarValue::counter(0)).unwrap();
+        doc.increment(ROOT, "count", 5).unwrap();
+    });
+    commit_as(&mut doc, "b", increment_by(-2));
+    assert_eq!(revert_run(&mut doc, run), 1);
+    assert_eq!(count_of(&doc), 3);
+}
+
+/// A list holding one counter at index 0, starting at zero.
+fn list_counter_doc() -> (AutoCommit, ObjId) {
+    let mut doc = AutoCommit::new().with_actor(ActorId::from(b"base".as_slice()));
+    let list = doc.put_object(ROOT, "list", ObjType::List).unwrap();
+    doc.insert(&list, 0, ScalarValue::counter(0)).unwrap();
+    doc.commit();
+    (doc, list)
+}
+
+fn list_counter_at(doc: &AutoCommit, list: &ObjId, index: usize) -> i64 {
+    match doc.get(list, index).unwrap().unwrap().0 {
+        Value::Scalar(scalar) => match scalar.as_ref() {
+            ScalarValue::Counter(counter) => i64::from(counter),
+            other => panic!("not a counter: {other:?}"),
+        },
+        Value::Object(_) => panic!("not a counter"),
+    }
+}
+
+fn list_str_at(doc: &AutoCommit, list: &ObjId, index: usize) -> Option<String> {
+    let (value, _) = doc.get(list, index).unwrap()?;
+    value.as_str().map(str::to_owned)
+}
