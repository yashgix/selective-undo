+    for first_merges_second in [true, false] {
+        let doc = concurrent_in_shared_map("a", "b", first_merges_second);
+
+        assert_eq!(
+            render(&doc, &ROOT),
+            serde_json::json!({"m": {"b": "second"}})
+        );
+    }
+}
