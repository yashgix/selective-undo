+/// The list element at `index` as of `heads`, named by its cursor.
+fn element_slot(doc: &AutoCommit, obj: &ObjId, index: usize, heads: &[ChangeHash]) -> Option<Slot> {
+    if !matches!(doc.object_type(obj), Ok(ObjType::List)) {
+        return None;
+    }
+    let cursor = doc.get_cursor(obj, index, Some(heads)).ok()?;
+    Some(Slot::Element(obj.clone(), cursor.to_string()))
+}
+
+/// The list elements a later change `p` (read between `lo` and `hi`) replaced,
+/// deleted or incremented.
+fn element_slots(
+    doc: &AutoCommit,
+    p: &Patch,
+    (lo, hi): (&[ChangeHash], &[ChangeHash]),
+) -> Vec<Slot> {
+    // A replaced or deleted element is named before the change: after a
+    // replacement the cursor at that index names the new value, not the element.
+    let (indices, heads) = match &p.action {
+        PatchAction::Increment {
+            prop: Prop::Seq(index),
+            ..
+        } => (*index..index.saturating_add(1), hi),
+        PatchAction::PutSeq { index, .. } => (*index..index.saturating_add(1), lo),
+        PatchAction::DeleteSeq { index, length } => (*index..index.saturating_add(*length), lo),
+        _ => return Vec::new(),
+    };
+    indices
+        .filter_map(|index| element_slot(doc, &p.obj, index, heads))
+        .collect()
+}
+
+/// The list element a counter increment in the inverse patch `p` lands on.
+fn element_increment(doc: &AutoCommit, p: &Patch, heads: &[ChangeHash]) -> Option<Slot> {
+    let PatchAction::Increment {
+        prop: Prop::Seq(index),
+        ..
+    } = &p.action
+    else {
+        return None;
+    };
+    element_slot(doc, &p.obj, *index, heads)
+}
